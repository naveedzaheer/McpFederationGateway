{
  "AllowedHosts": "localhost;127.0.0.1",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Federation": {
    "GatewayName": "mcp-federation-gateway",
    "GatewayVersion": "0.1.0",
    "RefreshIntervalSeconds": 60,
    "RequestTimeoutSeconds": 60,
    "DeniedTools": [
      "dangerous.*"
    ],
    "Servers": [
      {
        "Name": "server-a",
        "Namespace": "a",
        "Endpoint": "https://nzaplapimpubdemo.azure-api.net/game-review-mcp/mcp",
        "Enabled": true,
        "Headers": {}
      },
      {
        "Name": "server-b",
        "Namespace": "b",
        "Endpoint": "https://learn.microsoft.com/api/mcp",
        "Enabled": true,
        "Headers": {}
      }
    ]
  }
}